{
  "name": "app_pokemon",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "expo": "~57.0.26",
    "expo-router": "~57.0.24",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-web": "^0.21.2"
  },
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "backend": "node backend/scripts/dev.js",
    "backend:gateway": "node backend/gateway/src/index.js",
    "backend:pokemon": "node backend/services/pokemon-service/src/index.js",
    "backend:docentes": "node backend/services/docentes-service/src/index.js",
    "backend:onepiece": "cd backend/services/onepiece-service && .venv/bin/python -m uvicorn src.main:app --host 0.0.0.0 --port 4002",
    "backend:onepiece:env": "cd backend && npm run onepiece:env",
    "backend:seed": "node backend/scripts/seed.js && node backend/scripts/seed-docentes.js && cd backend/services/onepiece-service && .venv/bin/python seed.py",
    "backend:seed:pokemon": "node backend/scripts/seed.js",
    "backend:seed:onepiece": "cd backend/services/onepiece-service && .venv/bin/python seed.py",
    "backend:seed:docentes": "node backend/scripts/seed-docentes.js",
    "backend:datos": "node backend/scripts/generate-datos.js",
    "backend:verify": "node backend/scripts/verify.js",
    "backend:offline-test": "cd backend && npm run offline-test",
    "backend:setup": "cd backend && npm run setup"
  },
  "private": true,
  "devDependencies": {
    "typescript": "~6.0.3"
  }
}
