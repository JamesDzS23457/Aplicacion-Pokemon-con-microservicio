# Copia este archivo a .env y ajusta los valores.
# Esta en la RAIZ del proyecto, no dentro de backend/.
# NO lo subas al repositorio: .env ya esta en .gitignore.

# ===========================================================================
# FRONTEND  (esta es la unica variable que la app necesita)
# ===========================================================================
# URL del GATEWAY (puerto 3000). No apuntes a los microservicios.
# Local:               http://localhost:3000
# Produccion:          https://tu-gateway.onrender.com
#
# OJO en dispositivo fisico: "localhost" apunta al propio telefono, no a tu
# ordenador. Usa la IP de tu red (http://192.168.1.50:3000) o un tunel.
EXPO_PUBLIC_API_URL=http://localhost:3000

# ===========================================================================
# BASE DE DATOS  (solo microservicios)
# ===========================================================================
# Cada microservicio tiene SU PROPIA base de datos, por eso hay tres URLs y no
# dos: Pokemon y docentes usan proyectos de Supabase DISTINTOS (asi una tabla no
# puede pisar a la otra ni se mezclan los limites de 20), y One Piece usa MongoDB.
#
# OJO: dos proyectos de Supabase pueden tener contrasenas DISTINTAS aunque las
# dos bases sean del mismo tipo. Si te da `28P01 password authentication failed`,
# la clave es la del proyecto ese, no "la de Supabase".
#
# Como obtenerlas en Supabase:
#   Project > Settings > Database > Connection string > URI
#   Sale algo como: postgresql://postgres.xxxx:CLAVE@aws-0-region.pooler.supabase.com:5432/postgres
#   Usa la de "Session pooler" (puerto 5432), no la de Transaction.
POKEMON_DATABASE_URL=postgresql://postgres.TU_USUARIO:TU_CLAVE@OTRO_PROYECTO.pooler.supabase.com:5432/postgres
DOCENTES_DATABASE_URL=postgresql://postgres.TU_USUARIO:TU_CLAVE@TERCER_PROYECTO.pooler.supabase.com:5432/postgres

# One Piece usa una base NO RELACIONAL: MongoDB Atlas. Copia la URI tal cual la
# da el panel de Atlas ("Connect" > driver), con usuario y contrasena, y con
# retryWrites=true&w=majority (MongoDB Atlas lo exige en las escrituras).
ONEPIECE_MONGODB_URI=mongodb+srv://TU_USUARIO:TU_CLAVE@cluster0.TU_CLUSTER.mongodb.net/?appName=Cluster0&retryWrites=true&w=majority

# SSL. Supabase lo exige, asi que dejalo sin tocar.
# Ponlo en "false" SOLO si conectas a un Postgres local (Docker) sin SSL.
# MongoDB Atlas siempre cifra la conexion y no lee esta variable.
DATABASE_SSL=true

# ===========================================================================
# GATEWAY  (a donde reenvia las peticiones)
# ===========================================================================
# En produccion Render los rellena solo desde render.yaml.
POKEMON_SERVICE_URL=http://localhost:4001
ONEPIECE_SERVICE_URL=http://localhost:4002
DOCENTES_SERVICE_URL=http://localhost:4003

# ===========================================================================
# EJEMPLO DE POSTGRES LOCAL CON DOCKER  (para develops sin conexion a Supabase)
# ===========================================================================
#   docker run -d --name pg-local -e POSTGRES_PASSWORD=testpass \
#     -e POSTGRES_USER=postgres -p 5432:5432 postgres:16-alpine
#   docker exec pg-local psql -U postgres -c "CREATE DATABASE pokemon;"
#   docker exec pg-local psql -U postgres -c "CREATE DATABASE docentes;"
#   docker run -d --name mongo-local -p 27018:27017 mongo:7
#
#   POKEMON_DATABASE_URL=postgresql://postgres:testpass@localhost:5432/pokemon
#   DOCENTES_DATABASE_URL=postgresql://postgres:testpass@localhost:5432/docentes
#   ONEPIECE_MONGODB_URI=mongodb://localhost:27018
#   DATABASE_SSL=false
#
# El 27018 es a proposito: si publicas Mongo en el 27017 puedes chocar con un
# MongoDB que ya tengas instalado en la maquina.